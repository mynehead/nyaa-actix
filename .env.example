# A file path uses SQLite; a postgres:// URL uses PostgreSQL, e.g.
# DATABASE_URL=postgres://nyaa:password@localhost:5432/nyaa
DATABASE_URL=nyaa.db
# Must be at least 64 bytes. Generate with: openssl rand -hex 64
SECRET_KEY=change_me_to_the_output_of_openssl_rand_hex_64_which_is_128_hex_characters_long_xxxxx
SITE_NAME=Nyaa
SITE_FLAVOR=nyaa
RESULTS_PER_PAGE=75
MAX_PAGES=0
TORRENT_STORAGE_PATH=./torrents
ENABLE_GRAVATAR=false
MAINTENANCE_MODE=false
# Public base URL of the site, used in .torrent comments
SITE_URL=http://localhost:8080
# Comma separated announce URLs, own tracker first (written into magnets and .torrent files)
TRACKER_ANNOUNCE_URLS=udp://localhost:6969/announce,http://localhost:6969/announce
# Optional comma separated public fallback trackers, appended after the above
TRACKER_EXTRA_URLS=
