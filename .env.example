# nyaa-actix settings. Copy this file to .env and adjust.
# Every setting the app reads is listed here. Commented-out lines (# KEY=value) show
# optional settings or examples; remove the "# " to use one.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# A file path uses SQLite (default: nyaa.db); a postgres:// or postgresql:// URL uses PostgreSQL.
DATABASE_URL=nyaa.db

# PostgreSQL example (user nyaa, password "password", database nyaa on this machine):
# DATABASE_URL=postgres://nyaa:password@localhost:5432/nyaa

# MySQL / MariaDB example. NOT SUPPORTED YET: the app only speaks SQLite and PostgreSQL,
# and a mysql:// URL would be treated as a SQLite file name. Kept here for reference only.
# DATABASE_URL=mysql://nyaa:password@localhost:3306/nyaa

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Signs session cookies. Must be at least 64 bytes. Generate with: openssl rand -hex 64
# It also encrypts the two-factor (TOTP) secrets: changing it makes every user's two-factor
# setup unreadable, so they have to log in with a recovery code (or an admin resets it).
SECRET_KEY=change_me_to_the_output_of_openssl_rand_hex_64_which_is_128_hex_characters_long_xxxxx

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
SITE_NAME=Nyaa
# What both sites (nyaa and sukebei) are called together, used in mail subjects (default: SITE_NAME)
# GLOBAL_SITE_NAME=Nyaa.si
# nyaa or sukebei (picks the category set and icons)
SITE_FLAVOR=nyaa
# The sister site for the navbar link: "Fap" on a nyaa site goes to EXTERNAL_URL_FAP, "Fun" on a
# sukebei site goes to EXTERNAL_URL_MAIN. A bare host gets "//" in front. (default: empty, no link)
# EXTERNAL_URL_FAP=sukebei.example.com
# EXTERNAL_URL_MAIN=nyaa.example.com
# Public base URL of the site, used in .torrent comments
SITE_URL=http://localhost:8080
# Reverse proxies (addresses or CIDR networks, comma separated) whose X-Forwarded-For
# header names the visitor. Set this behind nginx, Caddy, Traefik or Docker, or every
# visitor gets the proxy's IP for bans, rate limits and logged IPs. Only list proxies you
# run: anyone connecting from these addresses can claim any IP. (default: empty, trust none)
# TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12
# Torrents per listing page, RSS feeds included (default: 75)
RESULTS_PER_PAGE=75
# Cap on how deep torrent listings and searches can be paged; later pages are a 404, 0 = no cap
# (default: 0; upstream uses 100)
MAX_PAGES=0
# How many listing totals to keep, and for how many seconds, so paging through a big listing
# doesn't count it again every time. COUNT_CACHE_DURATION=0 turns it off (default: 256 and 30)
# COUNT_CACHE_SIZE=256
# COUNT_CACHE_DURATION=30
# Torrents with more files than this show "Too many files to display." instead of the file list (default: 1000)
# MAX_FILES_VIEW=1000
# Show seeders, leechers and completed on the torrent page; false shows "Coming soon" (default: true)
# ENABLE_SHOW_STATS=true
# Avatars from Gravatar (or GRAVATAR_URL) for users who haven't uploaded one (default: false)
ENABLE_GRAVATAR=false
# Gravatar-compatible avatar service for ENABLE_GRAVATAR, e.g. Libravatar
# (https://seccdn.libravatar.org/avatar) or a self-hosted one. The site fetches the images
# itself and serves them as /avatar/<id>, so pages never contain the email hash and visitors
# never contact the service; only this server sends it the hash. (default: https://www.gravatar.com/avatar)
# GRAVATAR_URL=https://www.gravatar.com/avatar
# Email hash for the avatar URL: md5 (upstream, works everywhere) or sha256 (Gravatar and
# Libravatar support it; check your self-hosted service). (default: md5)
# GRAVATAR_HASH=md5
# Read-only maintenance: pages still show with a notice, but posts (uploads, comments,
# registration, admin actions) are turned back and the API answers 503 (default: false)
MAINTENANCE_MODE=false
# The notice shown on every page during maintenance (default: Site is currently in read-only maintenance mode.)
# MAINTENANCE_MODE_MESSAGE=Site is currently in read-only maintenance mode.
# Whether users can still log in and out during maintenance (default: true)
# MAINTENANCE_MODE_LOGINS=true
# Who may create an account: open (anyone, as upstream), invite (only with a code from
# Admin > Invites) or closed (nobody; use create-user) (default: open)
# REGISTRATION_MODE=open
# Days a new invite code stays valid (default: 7)
# INVITE_EXPIRY_DAYS=7
# Raid mode: new sign-ups still create an account, but it stays inactive (no login, no
# verification mail) until a moderator activates it on the user's page (default: false)
# RAID_MODE_LIMIT_REGISTER=false
# Shown to new sign-ups in raid mode, before the "ask a moderator" note (default: Registration is currently being limited.)
# RAID_MODE_REGISTER_MESSAGE=Registration is currently being limited.
# Accounts younger than this many seconds can't report torrents or groups, and get the upload rate limit below (default: 604800, one week)
# RATELIMIT_ACCOUNT_AGE=604800
# Seconds after posting during which authors may edit or delete their comment, 0 = no limit;
# moderators and admins have no limit on their own comments (default: 3600, one hour, as upstream)
# EDITING_TIME_LIMIT=3600
# Upload rate limit for accounts younger than RATELIMIT_ACCOUNT_AGE (trusted users skip it):
# after MAX_UPLOAD_BURST uploads within UPLOAD_BURST_DURATION seconds, each further upload
# must wait UPLOAD_TIMEOUT seconds after the previous one. Uploads from the same IP count too.
# Turn it off with RATELIMIT_UPLOADS=false (default: true)
# RATELIMIT_UPLOADS=true
# (default: 5)
# MAX_UPLOAD_BURST=5
# (default: 2700, 45 minutes)
# UPLOAD_BURST_DURATION=2700
# (default: 900, 15 minutes)
# UPLOAD_TIMEOUT=900

# ---------------------------------------------------------------------------
# Two-factor sign-in (codes from an authenticator app; each user turns it on under Profile)
# ---------------------------------------------------------------------------
# Users from this level up must set up two-factor before they can use the site:
# none, trusted, moderator or admin (default: none; recommended for production: moderator)
# MFA_REQUIRED_LEVEL=none
# Name the authenticator app shows for the account (default: SITE_NAME)
# MFA_ISSUER_NAME=Nyaa

# ---------------------------------------------------------------------------
# Trusted applications (who may apply at /trusted/request)
# ---------------------------------------------------------------------------
# Uploads (not counting remakes) a user needs before applying (default: 10)
# TRUSTED_MIN_UPLOADS=10
# Total downloads of those uploads needed before applying (default: 10000)
# TRUSTED_MIN_DOWNLOADS=10000
# Days a rejected user waits before applying again (default: 90)
# TRUSTED_REAPPLY_COOLDOWN=90

# ---------------------------------------------------------------------------
# Support tickets (/tickets; staff answer them at /admin/tickets)
# ---------------------------------------------------------------------------
# Staff are never limited. Set a limit to 0 to turn it off.
# New tickets a user may open per TICKET_RATE_WINDOW (default: 3)
# TICKET_RATE_LIMIT=3
# Length of that window in seconds (default: 86400, one day)
# TICKET_RATE_WINDOW=86400
# Replies a user may send per TICKET_REPLY_RATE_WINDOW (default: 20)
# TICKET_REPLY_RATE_LIMIT=20
# Length of that window in seconds (default: 3600, one hour)
# TICKET_REPLY_RATE_WINDOW=3600

# ---------------------------------------------------------------------------
# Mail (email verification and password reset). Off unless MAIL_BACKEND is set.
# ---------------------------------------------------------------------------
# smtp to send mail, or log to only write the mails (with their links) to the log,
# for development (default: empty, no mail)
# MAIL_BACKEND=smtp
# Sender of account mails, required with MAIL_BACKEND (default: none)
# MAIL_FROM_ADDRESS=Nyaa <noreply@example.com>
# SMTP server for MAIL_BACKEND=smtp (default: none)
# SMTP_SERVER=smtp.example.com
# starttls (port 587), tls (port 465) or none (port 25, unencrypted) (default: starttls)
# SMTP_SECURITY=starttls
# Port, if not the one SMTP_SECURITY implies (default: 587 for starttls)
# SMTP_PORT=587
# Login for the SMTP server, if it needs one (default: none)
# SMTP_USERNAME=
# SMTP_PASSWORD=
# New accounts stay inactive until they open the link mailed to them; needs MAIL_BACKEND (default: false)
# USE_EMAIL_VERIFICATION=false
# "Forgot your password?" on the login page, mailing a reset link valid for six hours;
# only shown when MAIL_BACKEND is set (default: true)
# ALLOW_PASSWORD_RESET=true

# ---------------------------------------------------------------------------
# Registration email blacklist (as upstream; turned-away sign-ups see "Blacklisted email provider")
# ---------------------------------------------------------------------------
# Regexes, separated by spaces, matched case-insensitively anywhere in the address; a plain
# "@dodgydomain.tk" works too. Keep the single quotes, or .env would read the backslashes.
# Unset blocks every Microsoft domain (hotmail, live, outlook, msn, passport), because Hotmail
# silently drops mail from "untrusted" senders, so those users never get their mails. Set it empty (EMAIL_BLACKLIST=) to allow every provider.
# (default: upstream's Microsoft list)
# EMAIL_BLACKLIST='@hotmail\.(co|co\.uk|com|de|dk|eu|fr|it|net|org|se) @live\.(co|co.uk|com|de|dk|eu|fr|it|net|org|se|no) @outlook\.(at|be|cl|co|co\.(id|il|nz|th)|com|com\.(ar|au|au|br|gr|pe|tr|vn)|cz|de|de|dk|dk|es|eu|fr|fr|hu|ie|in|it|it|jp|kr|lv|my|org|ph|pt|sa|se|sg|sk) @(msn\.com|passport\.(com|net))'
# Mail server IPs, comma separated: an address is refused when its domain's MX hosts resolve
# to one of these (MX server.com -> mail.server.com -> 11.22.33.44). Needs a DNS lookup per
# sign-up; a failed lookup lets the address through. (default: empty, off)
# EMAIL_SERVER_BLACKLIST=1.2.3.4,11.22.33.44

# ---------------------------------------------------------------------------
# Tracker
# ---------------------------------------------------------------------------
# Comma separated announce URLs, own tracker first (written into magnets and .torrent files)
TRACKER_ANNOUNCE_URLS=udp://localhost:6969/announce,http://localhost:6969/announce
# Optional comma separated public fallback trackers, appended after the above
TRACKER_EXTRA_URLS=
# Turn uploads away unless the .torrent lists MAIN_ANNOUNCE_URL among its trackers (default: false)
# ENFORCE_MAIN_ANNOUNCE_URL=false
# The tracker uploads must list (default: the first TRACKER_ANNOUNCE_URLS entry)
# MAIN_ANNOUNCE_URL=udp://localhost:6969/announce

# torrust-actix management API ([[api_server]] in its config.toml). When set, the site adds
# uploads to the tracker's whitelist, moves deleted and banned torrents from the whitelist
# to its blacklist (and back when restored), and fills the seeders, leechers and completed
# columns from it. Turn the tracker's whitelist on (whitelist_enabled = true, or
# TRACKER__WHITELIST_ENABLED=true) so it only tracks torrents from this site; turn its
# blacklist on too (blacklist_enabled = true, or TRACKER__BLACKLIST_ENABLED=true) so removed
# torrents stay refused even if the whitelist is ever switched off. Its API defaults to port 8080, which this site uses too: on one machine,
# move it (e.g. bind_address = "127.0.0.1:8081"). compose.yml sets this for you.
# Empty = no tracker calls, counts stay 0 (default: empty)
# TRACKER_API_URL=http://127.0.0.1:8081
# The tracker's API key (api_key in its config.toml, or TRACKER__API_KEY); compose.yml passes
# the same value to the tracker service (default: empty)
# TRACKER_API_KEY=
# How often seeders, leechers and completed counts are pulled from the tracker, in seconds
# (default: 300)
# TRACKER_STATS_SYNC_SECS=300

# ---------------------------------------------------------------------------
# File storage
# ---------------------------------------------------------------------------
# Where torrent info dicts and avatars are kept: local (the two folders below) or s3
STORAGE_BACKEND=local
TORRENT_STORAGE_PATH=./torrents
AVATAR_STORAGE_PATH=./avatars

# Only used with STORAGE_BACKEND=s3. These match the Garage dev server from docker/compose.yml;
# examples for Hetzner, Backblaze B2, Garage and RustFS are in docker/README.md.
S3_ENDPOINT=http://localhost:3900
S3_BUCKET=nyaa
S3_REGION=garage
S3_PATH_STYLE=true
S3_ACCESS_KEY=GK0123456789abcdef01234567
S3_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
S3_PREFIX=

# ---------------------------------------------------------------------------
# Search (optional Meilisearch, see docs/meilisearch.md)
# ---------------------------------------------------------------------------
# Leave MEILI_URL empty to search with the database only.
MEILI_URL=
MEILI_KEY=
MEILI_INDEX=torrents
# Most results a search counts and pages through (upstream ES_MAX_SEARCH_RESULT, 1000 there;
# Meilisearch calls it maxTotalHits) (default: 10000)
MEILI_MAX_HITS=10000
# How often changed tracker stats are pushed to the index, in seconds
MEILI_STATS_SYNC_SECS=60

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# error, warn, info, debug or trace (default: info). Can be narrowed per module,
# e.g. RUST_LOG=info,nyaa_actix=debug
# RUST_LOG=info

# ---------------------------------------------------------------------------
# Docker Compose (read by compose.yml, not by the app; see docker/DEPLOY.md)
# ---------------------------------------------------------------------------
# PostgreSQL password for the postgres service; the site's DATABASE_URL is built from it.
# Required for `docker compose up` (default: unset)
# POSTGRES_PASSWORD=
# TRACKER_API_KEY (see Tracker above) is required for `docker compose up`: the tracker
# service requires it, and the site uses it for whitelist and stats calls.
# Master key for the meilisearch service (`--profile search`); also put it in MEILI_KEY
# and set MEILI_URL=http://meilisearch:7700 (default: unset)
# MEILI_MASTER_KEY=
# Host port for the site (default: 8080)
# NYAA_PORT=8080
# Host port for the tracker, TCP and UDP (default: 6969)
# TRACKER_PORT=6969

# ---------------------------------------------------------------------------
# Tests only (read by `cargo test`, not by the server)
# ---------------------------------------------------------------------------
# Without these the matching tests are skipped. CI sets them in .github/workflows/ci.yml.

# torrust-actix round-trip test, against a tracker run with TRACKER__WHITELIST_ENABLED=true
# (default: unset, test skipped)
# TRACKER_TEST_URL=http://127.0.0.1:8080
# TRACKER_TEST_KEY=
# TRACKER_TEST_ANNOUNCE_URL=http://127.0.0.1:6969/announce

# PostgreSQL migration test database (default: unset, test skipped)
# TEST_POSTGRES_URL=postgres://postgres:postgres@localhost:5432/nyaa_test

# Meilisearch round-trip tests (default: unset, tests skipped)
# MEILI_TEST_URL=http://127.0.0.1:7700
# MEILI_TEST_KEY=

# S3 storage tests against a real bucket (default: unset, tests skipped).
# Same meaning as the S3_* settings above; see docker/README.md.
# NYAA_TEST_S3_BUCKET=nyaa
# NYAA_TEST_S3_ENDPOINT=http://localhost:3900
# NYAA_TEST_S3_REGION=garage
# NYAA_TEST_S3_PATH_STYLE=true
# NYAA_TEST_S3_ACCESS_KEY=
# NYAA_TEST_S3_SECRET_KEY=
# NYAA_TEST_S3_PREFIX=
