# nyaa-actix settings. Copy this file to .env and adjust.
# Every setting the app reads is listed here. Commented-out lines (# KEY=value) show
# optional settings or examples; remove the "# " to use one.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# A file path uses SQLite (default: nyaa.db); a postgres:// or postgresql:// URL uses PostgreSQL.
DATABASE_URL=nyaa.db

# PostgreSQL example (user nyaa, password "password", database nyaa on this machine):
# DATABASE_URL=postgres://nyaa:password@localhost:5432/nyaa

# MySQL / MariaDB example. NOT SUPPORTED YET: the app only speaks SQLite and PostgreSQL,
# and a mysql:// URL would be treated as a SQLite file name. Kept here for reference only.
# DATABASE_URL=mysql://nyaa:password@localhost:3306/nyaa

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Signs session cookies. Must be at least 64 bytes. Generate with: openssl rand -hex 64
SECRET_KEY=change_me_to_the_output_of_openssl_rand_hex_64_which_is_128_hex_characters_long_xxxxx

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
SITE_NAME=Nyaa
# nyaa or sukebei (picks the category set and icons)
SITE_FLAVOR=nyaa
# Public base URL of the site, used in .torrent comments
SITE_URL=http://localhost:8080
RESULTS_PER_PAGE=75
# Cap on how deep listings can be paged, 0 = no cap (not enforced yet)
MAX_PAGES=0
ENABLE_GRAVATAR=false
MAINTENANCE_MODE=false

# ---------------------------------------------------------------------------
# Trusted applications (who may apply at /trusted/request)
# ---------------------------------------------------------------------------
# Uploads (not counting remakes) a user needs before applying (default: 10)
# TRUSTED_MIN_UPLOADS=10
# Total downloads of those uploads needed before applying (default: 10000)
# TRUSTED_MIN_DOWNLOADS=10000
# Days a rejected user waits before applying again (default: 90)
# TRUSTED_REAPPLY_COOLDOWN=90

# ---------------------------------------------------------------------------
# Tracker
# ---------------------------------------------------------------------------
# Comma separated announce URLs, own tracker first (written into magnets and .torrent files)
TRACKER_ANNOUNCE_URLS=udp://localhost:6969/announce,http://localhost:6969/announce
# Optional comma separated public fallback trackers, appended after the above
TRACKER_EXTRA_URLS=

# ---------------------------------------------------------------------------
# File storage
# ---------------------------------------------------------------------------
# Where torrent info dicts and avatars are kept: local (the two folders below) or s3
STORAGE_BACKEND=local
TORRENT_STORAGE_PATH=./torrents
AVATAR_STORAGE_PATH=./avatars

# Only used with STORAGE_BACKEND=s3. These match the Garage dev server from docker/compose.yml;
# examples for Hetzner, Backblaze B2, Garage and RustFS are in docker/README.md.
S3_ENDPOINT=http://localhost:3900
S3_BUCKET=nyaa
S3_REGION=garage
S3_PATH_STYLE=true
S3_ACCESS_KEY=GK0123456789abcdef01234567
S3_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
S3_PREFIX=

# ---------------------------------------------------------------------------
# Search (optional Meilisearch, see docs/meilisearch.md)
# ---------------------------------------------------------------------------
# Leave MEILI_URL empty to search with the database only.
MEILI_URL=
MEILI_KEY=
MEILI_INDEX=torrents
# Most results a search counts and pages through
MEILI_MAX_HITS=10000
# How often changed tracker stats are pushed to the index, in seconds
MEILI_STATS_SYNC_SECS=60

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# error, warn, info, debug or trace (default: info). Can be narrowed per module,
# e.g. RUST_LOG=info,nyaa_actix=debug
# RUST_LOG=info

# ---------------------------------------------------------------------------
# Docker Compose (read by compose.yml, not by the app; see docker/DEPLOY.md)
# ---------------------------------------------------------------------------
# PostgreSQL password for the postgres service; the site's DATABASE_URL is built from it.
# Required for `docker compose up` (default: unset)
# POSTGRES_PASSWORD=
# API key the tracker service requires; the site will use it for whitelist and stats calls.
# Required for `docker compose up` (default: unset)
# TRACKER_API_KEY=
# Master key for the meilisearch service (`--profile search`); also put it in MEILI_KEY
# and set MEILI_URL=http://meilisearch:7700 (default: unset)
# MEILI_MASTER_KEY=
# Host port for the site (default: 8080)
# NYAA_PORT=8080
# Host port for the tracker, TCP and UDP (default: 6969)
# TRACKER_PORT=6969

# ---------------------------------------------------------------------------
# Tests only (read by `cargo test`, not by the server)
# ---------------------------------------------------------------------------
# Without these the matching tests are skipped. CI sets them in .github/workflows/ci.yml.

# PostgreSQL migration test database (default: unset, test skipped)
# TEST_POSTGRES_URL=postgres://postgres:postgres@localhost:5432/nyaa_test

# Meilisearch round-trip tests (default: unset, tests skipped)
# MEILI_TEST_URL=http://127.0.0.1:7700
# MEILI_TEST_KEY=

# S3 storage tests against a real bucket (default: unset, tests skipped).
# Same meaning as the S3_* settings above; see docker/README.md.
# NYAA_TEST_S3_BUCKET=nyaa
# NYAA_TEST_S3_ENDPOINT=http://localhost:3900
# NYAA_TEST_S3_REGION=garage
# NYAA_TEST_S3_PATH_STYLE=true
# NYAA_TEST_S3_ACCESS_KEY=
# NYAA_TEST_S3_SECRET_KEY=
# NYAA_TEST_S3_PREFIX=
