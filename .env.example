# Every setting the app reads from the environment is listed here. Lines that are
# commented out show the default the app uses when the setting is missing.

# A file path uses SQLite; a postgres:// URL uses PostgreSQL, e.g.
# DATABASE_URL=postgres://nyaa:password@localhost:5432/nyaa
DATABASE_URL=nyaa.db
# Must be at least 64 bytes. Generate with: openssl rand -hex 64
SECRET_KEY=change_me_to_the_output_of_openssl_rand_hex_64_which_is_128_hex_characters_long_xxxxx
SITE_NAME=Nyaa
SITE_FLAVOR=nyaa
RESULTS_PER_PAGE=75
MAX_PAGES=0
# Where torrent info dicts and avatars are kept: local (the two folders below) or s3
STORAGE_BACKEND=local
TORRENT_STORAGE_PATH=./torrents
AVATAR_STORAGE_PATH=./avatars
# For STORAGE_BACKEND=s3; examples for Hetzner, Backblaze B2, Garage and RustFS in docker/README.md.
# These match the Garage dev server from docker/compose.yml.
S3_ENDPOINT=http://localhost:3900
S3_BUCKET=nyaa
S3_REGION=garage
S3_PATH_STYLE=true
S3_ACCESS_KEY=GK0123456789abcdef01234567
S3_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
S3_PREFIX=
ENABLE_GRAVATAR=false
MAINTENANCE_MODE=false
# Public base URL of the site, used in .torrent comments
SITE_URL=http://localhost:8080
# Comma separated announce URLs, own tracker first (written into magnets and .torrent files)
TRACKER_ANNOUNCE_URLS=udp://localhost:6969/announce,http://localhost:6969/announce
# Optional comma separated public fallback trackers, appended after the above
TRACKER_EXTRA_URLS=
# Optional Meilisearch for text search and seeders/leechers/downloads sorts (see docs/meilisearch.md).
# Leave MEILI_URL empty to search with SQLite only.
MEILI_URL=
MEILI_KEY=
MEILI_INDEX=torrents
# Most results a search counts and pages through
MEILI_MAX_HITS=10000
# How often changed tracker stats are pushed to the index
MEILI_STATS_SYNC_SECS=60

# Log level for the server output: error, warn, info, debug or trace (default: info).
# Can be narrowed per module, e.g. RUST_LOG=info,nyaa_actix=debug
# RUST_LOG=info

# Test-only settings, read by `cargo test` and not by the server. Without them the matching
# tests are skipped. CI sets these in .github/workflows/ci.yml.
# Runs the PostgreSQL migration test against this database (default: unset, test skipped)
# TEST_POSTGRES_URL=postgres://postgres:postgres@localhost:5432/nyaa_test
# Runs the Meilisearch round-trip tests against this server (default: unset, tests skipped)
# MEILI_TEST_URL=http://127.0.0.1:7700
# MEILI_TEST_KEY=
# Runs the S3 storage tests against a real bucket (default: unset, tests skipped). The other
# NYAA_TEST_S3_* names mirror the S3_* settings above; see docker/README.md.
# NYAA_TEST_S3_BUCKET=nyaa
# NYAA_TEST_S3_ENDPOINT=http://localhost:3900
# NYAA_TEST_S3_REGION=garage
# NYAA_TEST_S3_PATH_STYLE=true
# NYAA_TEST_S3_ACCESS_KEY=
# NYAA_TEST_S3_SECRET_KEY=
# NYAA_TEST_S3_PREFIX=
